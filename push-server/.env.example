# Copy to .env and fill in. Generate the key pair with:  npm run keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:du@example.com

# The origin of the app. Leave it at * only while testing locally.
ALLOWED_ORIGIN=https://crimson-tide-tracker.leiding.net

# Optional
# PORT=8080
# TICK_SECONDS=30
# MAX_ENTRIES=10000
# RATE_PER_MIN=20
# TRUST_PROXY=1        # set when running behind a reverse proxy
