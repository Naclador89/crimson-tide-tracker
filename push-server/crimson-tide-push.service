# Alternative to Docker: run the relay directly under systemd.
#
#   sudo useradd --system --home /opt/crimson-tide-push --shell /usr/sbin/nologin ctt-push
#   sudo mkdir -p /opt/crimson-tide-push && sudo cp -r . /opt/crimson-tide-push/
#   cd /opt/crimson-tide-push && sudo -u ctt-push npm ci --omit=dev
#   sudo -u ctt-push cp .env.example .env && sudo -u ctt-push $EDITOR .env
#   sudo chmod 600 /opt/crimson-tide-push/.env
#   sudo cp crimson-tide-push.service /etc/systemd/system/
#   sudo systemctl enable --now crimson-tide-push
#
# Node is resolved via PATH, so nvm- and distro-installed runtimes both work.
# Still needs a reverse proxy with TLS in front of it (Caddy, nginx, Traefik):
# the browser will not talk to a plain-HTTP relay.

[Unit]
Description=Crimson Tide Tracker push relay
Documentation=https://github.com/Naclador89/crimson-tide-tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ctt-push
Group=ctt-push
WorkingDirectory=/opt/crimson-tide-push
EnvironmentFile=/opt/crimson-tide-push/.env
Environment=NODE_ENV=production
Environment=DATA_FILE=/var/lib/crimson-tide-push/subscriptions.json
ExecStart=/usr/bin/env node server.js
Restart=on-failure
RestartSec=5s

# The subscription store lives here and survives redeploys.
StateDirectory=crimson-tide-push
StateDirectoryMode=0700

# The service reads one config file, writes one state file and speaks HTTP.
# Nothing else needs to be reachable from it.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
